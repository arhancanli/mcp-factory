{
  "name": "package-truth-mcp",
  "version": "0.1.0",
  "description": "Checks that packages exist before an agent installs them: latest version, deprecation, known vulnerabilities and licence across npm, PyPI, Go, Maven, Cargo, NuGet and RubyGems.",
  "type": "module",
  "license": "MIT",
  "author": { "name": "Arhan Canli", "url": "https://github.com/arhancanli" },
  "bin": { "package-truth-mcp": "src/server.mjs" },
  "files": ["src", "README.md", "LICENSE", "npm-shrinkwrap.json"],
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.mjs", "start": "node src/server.mjs" },
  "dependencies": { "@modelcontextprotocol/sdk": "1.30.1", "zod": "4.6.5" },
  "mcpName": "io.github.arhancanli/package-truth-mcp",
  "keywords": ["mcp", "model-context-protocol", "mcp-server"],
  "repository": { "type": "git", "url": "git+https://github.com/arhancanli/mcp-factory.git", "directory": "servers/package-truth" },
  "homepage": "https://github.com/arhancanli/mcp-factory/tree/main/servers/package-truth#readme",
  "bugs": { "url": "https://github.com/arhancanli/mcp-factory/issues" },
  "factory": { "displayName": "Package Truth", "allowHosts": ["api.deps.dev"], "toolListBudget": 4000 }
}
