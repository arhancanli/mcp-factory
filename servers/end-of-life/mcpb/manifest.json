{
  "manifest_version": "0.3",
  "name": "end-of-life-mcp",
  "display_name": "End of Life",
  "version": "0.1.0",
  "description": "Tells coding agents whether a runtime, framework, database or OS version is still supported: end-of-life and security-support dates, days left, the latest patch and the version to upgrade to, for 470+ products, straight from a project's Dockerfile, .nvmrc, package.json, pyproject.toml, go.mod and CI files.",
  "author": {
    "name": "Arhan Canli",
    "url": "https://github.com/arhancanli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arhancanli/end-of-life-mcp"
  },
  "homepage": "https://github.com/arhancanli/end-of-life-mcp#readme",
  "documentation": "https://github.com/arhancanli/end-of-life-mcp#readme",
  "support": "https://github.com/arhancanli/end-of-life-mcp/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "developer-tools",
    "end-of-life",
    "eol",
    "endoflife",
    "lts",
    "runtime",
    "docker",
    "security",
    "upgrade"
  ],
  "server": {
    "type": "node",
    "entry_point": "src/server.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/src/server.mjs"
      ]
    }
  },
  "tools": [
    {
      "name": "check_project",
      "description": "Check a project's runtimes"
    },
    {
      "name": "check_versions",
      "description": "Check versions for end of life"
    },
    {
      "name": "product_lifecycle",
      "description": "A product's release cycles"
    }
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=20"
    }
  }
}
