{
  "name": "end-of-life-mcp",
  "version": "0.1.0",
  "description": "Tells coding agents whether a runtime, framework, database or OS version is still supported: end-of-life and security-support dates, days left, the latest patch and the version to upgrade to, for 470+ products, straight from a project's Dockerfile, .nvmrc, package.json, pyproject.toml, go.mod and CI files.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Arhan Canli",
    "url": "https://github.com/arhancanli"
  },
  "bin": {
    "end-of-life-mcp": "src/server.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "mcpName": "io.github.arhancanli/end-of-life-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "developer-tools",
    "end-of-life",
    "eol",
    "endoflife",
    "lts",
    "runtime",
    "docker",
    "security",
    "upgrade"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhancanli/end-of-life-mcp.git"
  },
  "homepage": "https://github.com/arhancanli/end-of-life-mcp#readme",
  "bugs": {
    "url": "https://github.com/arhancanli/end-of-life-mcp/issues"
  },
  "factory": {
    "displayName": "End of Life",
    "category": "developer-tools",
    "allowHosts": [
      "endoflife.date"
    ],
    "toolListBudget": 4000
  }
}
