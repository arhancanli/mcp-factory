{
  "name": "citation-check-mcp",
  "version": "0.1.0",
  "description": "Checks reference lists and BibTeX against Crossref, OpenAlex, arXiv, PubMed and DataCite: flags fabricated or mismatched citations field by field, flags retractions, and returns corrected BibTeX with DOIs.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Arhan Canli",
    "url": "https://github.com/arhancanli"
  },
  "bin": {
    "citation-check-mcp": "src/server.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "mcpName": "io.github.arhancanli/citation-check-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "science-research",
    "citations",
    "references",
    "bibtex",
    "retractions",
    "crossref",
    "hallucination",
    "doi",
    "arxiv",
    "pubmed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhancanli/citation-check-mcp.git"
  },
  "homepage": "https://github.com/arhancanli/citation-check-mcp#readme",
  "bugs": {
    "url": "https://github.com/arhancanli/citation-check-mcp/issues"
  },
  "factory": {
    "displayName": "Citation Check",
    "category": "science-research",
    "allowHosts": [
      "api.crossref.org",
      "api.datacite.org",
      "eutils.ncbi.nlm.nih.gov",
      "api.openalex.org",
      "doi.org"
    ],
    "toolListBudget": 4000,
    "linkHosts": [
      "pubmed.ncbi.nlm.nih.gov"
    ]
  }
}
